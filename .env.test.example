APP_NAME='Occupancy Detection Service'
APP_VERSION=0.7

HOST=your_host
PORT=your_port
PYTHON_EXE=your_python_exe
JMETER_HOME=your_jmeter_home

USE_MOCK=true

VIDEO_SOURCE=0
MODEL_PATH=yolov8n.pt

ROI_X1=100
ROI_Y1=100
ROI_X2=500
ROI_Y2=400

ENTER_FRAMES=5
LEAVE_SECONDS=2.0
CONFIDENCE=0.4

RECONNECT_INTERVAL=2.0
LOOP_INTERVAL=0.05

MOCK_INTERVAL=1.0

AUTH_USERNAME=your_admin_username
AUTH_PASSWORD=__CHANGE_ME__
AUTH_PASSWORD_HASH=
ADMIN_REGISTRATION_CODE=__CHANGE_ME__
AUTH_COOKIE_NAME=occupancy_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_TTL_SEC=28800
AUTH_RATE_LIMIT_WINDOW_SEC=600
AUTH_RATE_LIMIT_MAX_ATTEMPTS=8
AUTH_RATE_LIMIT_LOCK_SEC=120
STAT_SYNC_INTERVAL_SEC=5.0

CORS_ALLOW_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8000","http://localhost:8000"]

MYSQL_HOST=your_mysql_host
MYSQL_PORT=your_mysql_port
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=your_mysql_database

REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_DB=your_redis_db
REDIS_PASSWORD=
